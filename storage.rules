rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '7SBL73wlj7OxKBsMExoJNhdrDTU2' ||
        request.auth.token.email == 'mathurasupermrkt@gmail.com' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Promotional Banners folder:
    // Anyone can read banner images; only authorized admins can upload, edit, or delete them
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery proof-of-delivery uploads
    // Only an approved delivery partner may upload a proof image for a specific order.
    // File must be ≤ 10 MB and an image type.
    match /orders/{orderId}/proof/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'delivery'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Default fallback — only admins may write to any other storage path.
    // Public read is preserved for product images, icons, etc.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
