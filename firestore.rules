rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'vikramsenthilkumar164@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isDelivery() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery';
    }

    // Products, Categories, Coupons: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional Banners:
    // - Customers may read published active banners
    // - Only authorized admins may create, update, publish, reorder, or delete banners
    match /banners/{bannerId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    // Users and their sub-collections (cart, wishlist)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isDelivery();
      allow write: if isOwner(userId) || isAdmin();
      
      match /cart/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /returns/{returnId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Helper: Check if store is open (defaults to true if settings/store doesn't exist)
    function isStoreOpen() {
      return !exists(/databases/(default)/documents/settings/store) ||
             get(/databases/(default)/documents/settings/store).data.isOpen != false;
    }

    // Orders:
    // - Authenticated users can create orders ONLY when store is open (or if Admin)
    //   and the order userId MUST match the authenticated user's UID
    // - Customers can only read their own orders
    // - Admins and Delivery Partners can read orders
    // - Customer can only update their own order; Admins and Delivery can update order status
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (isAdmin() || (isStoreOpen() && request.resource.data.userId == request.auth.uid));
      allow read: if isAdmin() || isDelivery() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isDelivery() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Reviews:
    // - Anyone can read
    // - Authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Delivery Partners:
    // - Partner can only write their own location doc (uid must match doc id)
    // - Authenticated customers and admins can read (to track their delivery)
    match /deliveryPartners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(partnerId) || isAdmin();
    }

    // Inventory, Purchase Bills, Suppliers: Only Admins can access
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /purchaseBills/{billId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // WhatsApp Message Center & Campaigns: Admin controlled, authenticated users can queue their order messages
    match /whatsappMessages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /whatsappCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
  }
}
