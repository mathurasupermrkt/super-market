
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // AUTHENTICATION AND ROLE HELPERS
    // --------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId;
    }

    function userExists(userId) {
      return exists(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (
            'email' in request.auth.token &&
            request.auth.token.email ==
              'vikramsenthilkumar164@gmail.com'
          ) ||
          (
            userExists(request.auth.uid) &&
            userRole() == 'admin'
          )
        );
    }

    function isDelivery() {
      return isAuthenticated() &&
        userExists(request.auth.uid) &&
        userRole() == 'delivery';
    }

    // --------------------------------------------------
    // STORE SETTINGS
    // --------------------------------------------------

    function isStoreOpen() {
      return !exists(
        /databases/$(database)/documents/settings/store
      ) ||
      get(
        /databases/$(database)/documents/settings/store
      ).data.isOpen != false;
    }

    function isValidCustomerLocation(loc) {
      return loc is map &&
        loc.keys().hasAll(['latitude', 'longitude']) &&
        loc.latitude is number &&
        loc.longitude is number &&
        loc.latitude >= -90 &&
        loc.latitude <= 90 &&
        loc.longitude >= -180 &&
        loc.longitude <= 180 &&
        (
          !('formattedAddress' in loc) ||
          loc.formattedAddress == null ||
          loc.formattedAddress is string
        );
    }

    // --------------------------------------------------
    // PRODUCTS, CATEGORIES, BRANDS AND COUPONS
    // --------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customers should query banners with isActive == true.
    match /banners/{bannerId} {
      allow read: if isAdmin() ||
        resource.data.isActive == true;

      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // USER PROFILES
    // --------------------------------------------------

    match /users/{userId} {

      allow read: if isOwner(userId) ||
        isAdmin() ||
        isDelivery();

      // A customer can create only their own basic profile.
      // Admin and delivery roles must be assigned through
      // a trusted administrative process.
      allow create: if isAdmin() ||
        (
          isOwner(userId) &&
          (
            !('role' in request.resource.data) ||
            request.resource.data.role == 'customer'
          )
        );

      // A user cannot change their own role.
      allow update: if isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(['role'])
        );

      allow delete: if isAdmin();

      match /cart/{productId} {
        allow read, write: if isOwner(userId) ||
          isAdmin();
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) ||
          isAdmin();
      }

      match /returns/{returnId} {
        allow read, write: if isOwner(userId) ||
          isAdmin();
      }
    }

    // --------------------------------------------------
    // ORDERS
    // --------------------------------------------------

    match /orders/{orderId} {

      // Customers can create only their own orders.
      // Prices and item details must ALSO be validated
      // by trusted checkout/backend code.
      allow create: if isAuthenticated() &&
        (
          isAdmin() ||
          (
            isStoreOpen() &&
            request.resource.data.userId ==
              request.auth.uid &&
            request.resource.data.status in [
              'pending',
              'confirmed'
            ] &&
            request.resource.data.driverId == null &&
            request.resource.data.total is number &&
            request.resource.data.total >= 0
          )
        );

      allow read: if isAdmin() ||
        isDelivery() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin() ||

        // Delivery partner accepts an assigned request.
        (
          isDelivery() &&
          request.resource.data.userId ==
            resource.data.userId &&
          request.resource.data.total ==
            resource.data.total &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'updatedAt',
              'driverId',
              'driverName',
              'deliveryRequestStatus',
              'declinedDrivers'
            ]) &&
          (
            // Accept an unassigned delivery request.
            (
              request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['driverId']) &&
              request.resource.data.driverId ==
                request.auth.uid &&
              resource.data.driverId == null &&
              resource.data.deliveryRequestStatus ==
                'pending' &&
              request.resource.data.deliveryRequestStatus ==
                'accepted' &&
              request.resource.data.status == 'assigned' &&
              (
                !('declinedDrivers' in resource.data) ||
                !resource.data.declinedDrivers
                  .hasAny([request.auth.uid])
              )
            ) ||

            // Update the delivery status.
            (
              request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['status', 'updatedAt']) &&
              resource.data.driverId == request.auth.uid &&
              (
                (
                  resource.data.status in [
                    'assigned',
                    'confirmed',
                    'processing',
                    'packed'
                  ] &&
                  request.resource.data.status in [
                    'out-delivery',
                    'cancelled'
                  ]
                ) ||
                (
                  resource.data.status == 'out-delivery' &&
                  request.resource.data.status in [
                    'delivered',
                    'cancelled'
                  ]
                )
              )
            ) ||

            // Decline a delivery request.
            (
              request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['declinedDrivers']) &&
              resource.data.driverId == null &&
              request.resource.data.declinedDrivers is list &&
              request.resource.data.declinedDrivers
                .hasAll([request.auth.uid]) &&
              (
                !('declinedDrivers' in resource.data) ||
                request.resource.data.declinedDrivers
                  .hasAll(resource.data.declinedDrivers)
              ) &&
              request.resource.data.declinedDrivers.size() ==
                (
                  (
                    'declinedDrivers' in resource.data
                  )
                  ? resource.data.declinedDrivers.size() + 1
                  : 1
                )
            )
          )
        ) ||

        // Customer can update only their delivery location.
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId ==
            resource.data.userId &&
          request.resource.data.total ==
            resource.data.total &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['customerLocation']) &&
          isValidCustomerLocation(
            request.resource.data.customerLocation
          )
        ) ||

        // Customer can cancel a pending or confirmed order.
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId ==
            resource.data.userId &&
          request.resource.data.total ==
            resource.data.total &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'cancelled' &&
          resource.data.status in [
            'pending',
            'confirmed'
          ]
        );

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // REVIEWS
    // --------------------------------------------------

    match /reviews/{reviewId} {
      allow read: if true;

      // A user may create a review only for themselves.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Only the review owner or admin can edit/delete.
      // The owner cannot transfer the review to another user.
      allow update: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId ==
            resource.data.userId
        );

      allow delete: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid
        );
    }

    // --------------------------------------------------
    // DELIVERY PARTNERS
    // --------------------------------------------------

    match /deliveryPartners/{partnerId} {

      // Only the delivery partner and admins can read partner details.
      allow read: if isAdmin() ||
        isOwner(partnerId);

      // Only verified delivery partners can manage their own data; admins can manage all.
      allow create, update: if isAdmin() ||
        (
          isDelivery() &&
          isOwner(partnerId)
        );

      allow delete: if isAdmin();
    }

    // --------------------------------------------------
    // INVENTORY AND PURCHASE MANAGEMENT
    // --------------------------------------------------

    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /purchaseBills/{billId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // --------------------------------------------------
    // SETTINGS
    // --------------------------------------------------

    // Existing settings remain public-readable for compatibility.
    // Do not store secrets or private configuration here.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --------------------------------------------------
    // WHATSAPP MESSAGES
    // --------------------------------------------------

    match /whatsappMessages/{messageId} {

      allow read: if isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.customerId == request.auth.uid
        );

      // Restrict creation to the customer's own message.
      // Adjust allowed fields to match the actual message schema.
      allow create: if isAuthenticated() &&
        request.resource.data.customerId ==
          request.auth.uid &&
        request.resource.data.keys().hasAll([
          'customerId'
        ]) &&
        request.resource.data.keys().hasOnly([
          'customerId',
          'message',
          'messageType',
          'createdAt',
          'orderId'
        ]);

      // Provider status and delivery results should be written
      // by trusted backend code, not customers.
      allow update, delete: if isAdmin();
    }

    match /whatsappCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
  }
}
