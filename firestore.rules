rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'vikramsenthilkumar164@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Products, Categories, Coupons: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users and their sub-collections (cart, wishlist)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
      
      match /cart/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /returns/{returnId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders:
    // - Authenticated users can create and read orders
    // - Admins and Delivery staff can update orders
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Reviews:
    // - Anyone can read
    // - Authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Delivery Partners:
    // - Partner can only write their own location doc (uid must match doc id)
    // - Authenticated customers and admins can read (to track their delivery)
    match /deliveryPartners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(partnerId) || isAdmin();
    }

    // Inventory, Purchase Bills, Suppliers: Only Admins can access
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /purchaseBills/{billId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
