rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'vikramsenthilkumar164@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isDelivery() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery';
    }

    // Products, Categories, Coupons: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotional Banners:
    // - Customers may read published active banners
    // - Only authorized admins may create, update, publish, reorder, or delete banners
    match /banners/{bannerId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    // Users and their sub-collections (cart, wishlist)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isDelivery();
      allow write: if isOwner(userId) || isAdmin();
      
      match /cart/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /returns/{returnId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Helper: Check if store is open (defaults to true if settings/store doesn't exist)
    function isStoreOpen() {
      return !exists(/databases/(default)/documents/settings/store) ||
             get(/databases/(default)/documents/settings/store).data.isOpen != false;
    }

    // Helper: Validate customerLocation map format
    function isValidCustomerLocation(loc) {
      return loc is map &&
        loc.latitude is number &&
        loc.longitude is number &&
        (!('formattedAddress' in loc) || loc.formattedAddress is string || loc.formattedAddress == null);
    }

    // Orders:
    // - Authenticated users can create orders ONLY when store is open (or if Admin),
    //   userId must match authenticated UID, initial status must be 'confirmed' or 'pending',
    //   and driverId must be null.
    // - Customers can only read their own orders; Admins & Delivery can read all orders.
    // - Updates are strictly partitioned by role:
    //   * Admin: full update
    //   * Delivery Partner: only delivery assignment and status transitions
    //   * Customer: only customerLocation or cancellation of unfulfilled orders
    // - Delete: Admin only
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isStoreOpen() &&
          request.resource.data.userId == request.auth.uid &&
          (request.resource.data.status in ['confirmed', 'pending']) &&
          request.resource.data.driverId == null
        )
      );
      allow read: if isAdmin() || isDelivery() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isDelivery() && (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.total == resource.data.total &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'driverId', 'driverName', 'deliveryRequestStatus', 'declinedDrivers'
          ])
        )
      ) || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.total == resource.data.total &&
        (
          // Case 1: Customer updating delivery GPS location during checkout
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerLocation']) &&
           isValidCustomerLocation(request.resource.data.customerLocation)) ||
          // Case 2: Customer cancelling an unfulfilled order
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
           request.resource.data.status == 'cancelled' &&
           (resource.data.status in ['confirmed', 'pending']))
        )
      );
      allow delete: if isAdmin();
    }

    // Reviews:
    // - Anyone can read
    // - Authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Delivery Partners:
    // - Partner can only write their own location doc (uid must match doc id)
    // - Authenticated customers and admins can read (to track their delivery)
    match /deliveryPartners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(partnerId) || isAdmin();
    }

    // Inventory, Purchase Bills, Suppliers: Only Admins can access
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /purchaseBills/{billId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // WhatsApp Message Center & Campaigns: Admin controlled, authenticated users can queue their order messages
    match /whatsappMessages/{messageId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /whatsappCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
  }
}
