rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'admin' || 
         request.auth.token.email == 'vikramsenthilkumar164@gmail.com');
    }

    // Products, Categories, Coupons: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users and their sub-collections (cart, wishlist)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /cart/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Orders:
    // - Authenticated users can create orders for themselves (request.resource.data.userId == request.auth.uid)
    // - Authenticated users can read their own orders (resource.data.userId == request.auth.uid)
    // - Admins can read/write all orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reviews:
    // - Anyone can read
    // - Authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}
