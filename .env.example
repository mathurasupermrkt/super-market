# =================================================================
# Mathura QuickMart — WhatsApp Business Cloud API Configuration
# Add these environment variables in your Vercel Project Settings
# =================================================================

# Meta WhatsApp Business Cloud API Credentials (from developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=EAAB...your_system_user_access_token_here...
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_ACCOUNT_ID=293847561029384
WHATSAPP_API_VERSION=v20.0

# Meta Webhook Verification Token (custom secret chosen by you for Meta Webhook setup)
WHATSAPP_VERIFY_TOKEN=mathura_quickmart_secret_webhook_verify_token_2026

# Meta App Secret (used to verify incoming webhook signatures)
META_APP_SECRET=your_meta_app_secret_here

# Firebase Configuration (Optional if using service account for backend operations)
FIREBASE_PROJECT_ID=mathura-quickmart-v2
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Internal API Secret for Admin operations (optional)
ADMIN_SECRET_KEY=mathura_admin_key_2026
